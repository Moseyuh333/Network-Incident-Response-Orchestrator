# ── Core ────────────────────────────────────────────────────────────────
APP_NAME=Network Incident Response Orchestrator
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./niro.db

# ── LLM Configuration ────────────────────────────────────────────────────
# At least one of these must be set for LLM analysis to work.
# Leave unset to use rule-based fallback only.
LLM_PROVIDER=anthropic          # anthropic | openai | ollama | gemini
LLM_API_KEY=
LLM_API_BASE=                   # override base URL for openai/ollama/gemini
LLM_MODEL=                      # model name; defaults per provider below
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# Default models per provider
LLM_MODEL_ANTHROPIC=claude-sonnet-4-20250514
LLM_MODEL_OPENAI=gpt-4o
LLM_MODEL_OLLAMA=llama3.1:8b
LLM_MODEL_GEMINI=gemini-1.5-flash

# ── Detection Thresholds ─────────────────────────────────────────────────
PORT_SCAN_THRESHOLD=10          # distinct dest ports in window to flag scan
PORT_SCAN_WINDOW_SECONDS=60
BRUTE_FORCE_THRESHOLD=5         # failed attempts from same IP
BRUTE_FORCE_WINDOW_SECONDS=120
WEB_ATTACK_PATTERNS=true
EXFIL_THRESHOLD_MB=50           # outbound MB in window → flag
EXFIL_WINDOW_SECONDS=300
BEACON_INTERVAL_MIN=5           # min seconds between repeated connections
BEACON_INTERVAL_MAX=60
BEACON_REPEAT_COUNT=6           # repeated connections to same host
FLOOD_THRESHOLD=100             # requests to same dest in window
FLOOD_WINDOW_SECONDS=60

# ── Response ─────────────────────────────────────────────────────────────
# Real network-blocking actions are DISABLED by default.
# Set to true ONLY in isolated lab environments.
ENABLE_REAL_RESPONSE=false
ALLOWED_REAL_ACTIONS=simulate_block_ip,simulate_quarantine_host,simulate_disable_user,simulate_notify_admin

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
