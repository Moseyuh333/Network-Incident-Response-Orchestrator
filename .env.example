# Core
APP_NAME=Network Incident Response Orchestrator
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./niro.db

# Optional AI/LLM configuration
# Leave keys empty for offline rule-based mode.
# Never commit a populated .env file.
LLM_PROVIDER=google
LLM_API_KEY=
GOOGLE_API_KEY=
LLM_API_BASE=
LLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# Default models per provider
LLM_MODEL_ANTHROPIC=claude-sonnet-4-20250514
LLM_MODEL_OPENAI=gpt-4o
LLM_MODEL_OLLAMA=llama3.1:8b
LLM_MODEL_GEMINI=models/gemma-4-31b-it
LLM_MODEL_GOOGLE=models/gemma-4-31b-it

# Detection thresholds
PORT_SCAN_THRESHOLD=10
PORT_SCAN_WINDOW_SECONDS=60
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=120
WEB_ATTACK_PATTERNS=true
EXFIL_THRESHOLD_MB=50
EXFIL_WINDOW_SECONDS=300
BEACON_INTERVAL_MIN=5
BEACON_INTERVAL_MAX=60
BEACON_REPEAT_COUNT=6
FLOOD_THRESHOLD=100
FLOOD_WINDOW_SECONDS=60

# Response safety
# Real actions are disabled by default. Keep false for class demo.
ENABLE_REAL_RESPONSE=false
ALLOWED_REAL_ACTIONS=simulate_block_ip,simulate_quarantine_host,simulate_disable_user,simulate_notify_admin

# API / UI
CORS_ORIGINS=*
